# AutoCon5 WS:C2 — laptop lab environment
# Copy this to `.env` before running `docker compose up`.
# All values have working defaults — you do not need a real API key.

# MCP API key — any string, agents must match this. Default is fine.
MCP_API_KEY=dev-key-123

# LLM provider — keep "stub" for the workshop. Returns canned responses keyed off scenario_id.
# Set to "openai" + provide OPENAI_API_KEY only if you want to experiment after the workshop.
LLM_PROVIDER=stub

# Optional — only used if LLM_PROVIDER=openai. Workshop labs work fine with the stub.
OPENAI_API_KEY=

# Mock device mode — keep false for the laptop lab. The MCP server simulates 3 routers in-process.
USE_REAL_DEVICES=false

# Log level — INFO for the workshop. Set to DEBUG if you want to read the agent reasoning verbatim.
LOG_LEVEL=INFO
